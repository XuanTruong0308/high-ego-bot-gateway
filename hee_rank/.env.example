# ─── HEe Chronicle (P6) — Rank Interaction Bot ───
# Sao chép file này thành .env và điền thông tin thật

# [BẮT BUỘC] Token bot từ Discord Developer Portal
BOT_TOKEN=your_bot_token_here

# [BẮT BUỘC] Server ID của High Ego eSport
GUILD_ID=1545800312302870599

# ─── Cấu hình XP (tuỳ chỉnh) ───

# XP nhận được khi gửi 1 tin nhắn
XP_MSG=1

# XP nhận được khi thả 1 reaction
XP_REACTION=0.5

# XP nhận được mỗi phút trong voice channel
XP_VOICE_PER_MIN=2

# Thời gian cooldown giữa 2 tin nhắn được tính XP (giây)
# Giúp chống spam để farm XP
MSG_COOLDOWN=60
