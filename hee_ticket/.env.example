# ─── HEe Tribunal (P4) — Ticket Support System ───

# [BẮT BUỘC] Token bot từ Discord Developer Portal
BOT_TOKEN=your_bot_token_here

# [BẮT BUỘC] Server ID của High Ego eSport
GUILD_ID=1545800312302870599

# [CẤU HÌNH ROLE HE] Tên hoặc ID của Role HE có quyền xem, claim và đóng ticket
HE_ROLE_NAME=HE

# [TÙY CHỌN] ID của Category chứa các kênh ticket (để 0 nếu muốn tạo ở ngoài)
TICKET_CATEGORY_ID=0

# [TÙY CHỌN] ID kênh gửi log kèm file transcript khi ticket được đóng (để 0 nếu không dùng)
TRANSCRIPT_LOG_CHANNEL_ID=0

# [TỰ ĐỘNG ĐÓNG] Thời gian không có tin nhắn mới sẽ tự động đóng ticket (tính bằng giây, 10800s = 3 tiếng)
AUTO_CLOSE_SECONDS=10800
